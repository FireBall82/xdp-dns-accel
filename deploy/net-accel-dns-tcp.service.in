[Unit]
Description=Local TCP DNS fallback for Net Accel
Requires=net-accel-dns-prepare.service
After=net-accel-dns-prepare.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@UNBOUND_EXECUTABLE@ -d -c /run/net-accel-dns/unbound.conf
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
