[Unit]
Description=Net Accel localhost UDP DNS resolver
Requires=net-accel-dns-prepare.service
After=net-accel-dns-prepare.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/dnsctl launch
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
TimeoutStopSec=8
KillMode=mixed
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_KILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/dev/shm
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=multi-user.target
